
module alu_8bit (
    input  wire [7:0] a,
    input  wire [7:0] b,
    input  wire [3:0] opcode,
    output reg  [7:0] result,
    output wire       zero,
    output reg        carry
);

    reg [8:0] temp;

    always @(*) begin
        result = 8'b0;
        carry  = 1'b0;
        temp   = 9'b0;

        case (opcode)
            4'b0000: begin
                temp   = {1'b0, a} + {1'b0, b};
                result = temp[7:0];
                carry  = temp[8];
            end

            4'b0001: begin
                result = a - b;
                carry  = (a >= b);
            end

            4'b0010: result = a & b;
            4'b0011: result = a | b;
            4'b0100: result = a ^ b;
            4'b0101: result = ~a;
            4'b0110: result = a << b[2:0];
            4'b0111: result = a >> b[2:0];
            4'b1000: result = (a < b) ? 8'd1 : 8'd0;
            4'b1001: result = (a == b) ? 8'd1 : 8'd0;

            default: result = 8'b0;
        endcase
    end

    assign zero = (result == 8'b0);

endmodule
